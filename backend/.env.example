# Travio AI - Backend Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Travio AI Backend"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000","*"]

# Supabase Auth Settings (Used in Milestone 2)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_AUDIENCE=authenticated

# PostgreSQL Database (Used in Milestone 2)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travio_db

# External Provider Credentials (Used in Milestone 4)
GEOAPIFY_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
OPENAI_API_KEY=
